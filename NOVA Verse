 addXP(5,'Daily challenge'); const fn=games[Math.floor(Math.random()*games.length)]; if(typeof window[fn]==='function')window[fn](); showPage('games');
}
/* richer command center */
function renderCommands(){
 const q=($('commandInput')?.value||'').toLowerCase().trim();const cmds=[
 ['🤖','Nova AI','nova'],['🔎','Google Search','search'],['🎮','Games','games'],['❤️','Health Lab','health'],['📚','Nova Academy','academy'],['☪','Quran & Islam','islam'],['📝','Workspace','workspace'],['👤','My Profile','profile'],['🏆','Competition Mode','competition'],['⚙','Settings','settings']];
 $('commands').innerHTML=cmds.filter(x=>!q||x[1].toLowerCase().includes(q)).map(x=>`<div class="result" style="display:flex;justify-content:space-between;align-items:center"><span>${x[0]} <b>${x[1]}</b></span><button class="btn" onclick="closeCommand();showPage('${x[2]}')">Open</button></div>`).join('')||'<p style="color:var(--muted)">No command found.</p>';
}
function openCommand(){ $('commandModal').classList.add('show'); $('commandInput').value=''; renderCommands(); setTimeout(()=>$('commandInput').focus(),50)}
function closeCommand(){$('commandModal').classList.remove('show')}
function init(){
  const idea=localStorage.getItem('nova_idea_lab'); if($('ideaLab')) $('ideaLab').value=idea||'';
 renderHome();renderList(movies,'movieGrid','movie');renderList(songs,'songGrid','song');renderDiscover();renderRecords();updatePulse();setInterval(updatePulse,1000);
 renderSports();renderEducation();renderIslam();renderShops();renderHistory();renderTasks();initHealthChecklist();renderProfile();initAcademy();renderCommands();
 $('notes').value=state.notes;paintTimer();initChat();
}
init();



