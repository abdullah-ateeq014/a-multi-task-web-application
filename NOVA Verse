<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#03050b">
<title>Nova Verse — Advanced AI Universe</title>
<style>
:root{
  --bg:#03050b;--panel:#070b14;--panel2:#0a101c;--card:#0b1220;
  --text:#e8eefc;--muted:#93a4c3;--line:rgba(255,255,255,.09);
  --accent:#7c5cff;--accent2:#00d4ff;--good:#34d399;--danger:#fb7185;
  --shadow:0 18px 60px rgba(0,0,0,.35);--radius:22px
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;background:
radial-gradient(circle at 15% 10%,rgba(124,92,255,.18),transparent 30%),
radial-gradient(circle at 90% 20%,rgba(0,212,255,.12),transparent 25%),var(--bg);
color:var(--text);min-height:100vh;overflow-x:hidden}
button,input,textarea,select{font:inherit}
button{cursor:pointer}
a{color:inherit;text-decoration:none}
.app{display:flex;min-height:100vh}
.sidebar{position:fixed;z-index:20;left:0;top:0;bottom:0;width:270px;padding:20px 16px;
background:rgba(5,8,16,.96);backdrop-filter:blur(22px);border-right:1px solid var(--line);
overflow:auto;transition:.3s}
.brand{display:flex;align-items:center;gap:12px;padding:8px 10px 20px}
.logo{width:44px;height:44px;border-radius:15px;display:grid;place-items:center;font-weight:900;
background:linear-gradient(135deg,var(--accent),var(--accent2));box-shadow:0 0 35px rgba(124,92,255,.35)}
.brand h1{font-size:20px}.brand small{color:var(--muted)}
.nav-title{font-size:11px;text-transform:uppercase;letter-spacing:1.5px;color:#64748b;padding:12px 12px 7px}
.nav{display:grid;gap:6px}
.nav button{border:0;background:transparent;color:var(--muted);padding:12px;border-radius:14px;
text-align:left;display:flex;align-items:center;gap:12px;transition:.2s}
.nav button:hover,.nav button.active{background:linear-gradient(90deg,rgba(124,92,255,.18),rgba(0,212,255,.07));color:var(--text)}
.nav button.active{box-shadow:inset 3px 0 var(--accent)}
.nav .ico{width:22px;text-align:center}
.sidebar-bottom{margin-top:18px;padding-top:15px;border-top:1px solid var(--line)}
.main{margin-left:270px;width:calc(100% - 270px);min-height:100vh;padding:22px 28px 60px}
.topbar{height:64px;display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:10;
background:rgba(4,7,14,.96);backdrop-filter:blur(18px)}
.searchbox{flex:1;max-width:720px;position:relative}
.searchbox input{width:100%;padding:14px 46px 14px 17px;border-radius:16px;border:1px solid var(--line);
background:#060b15;color:var(--text);outline:none}
.searchbox input:focus{border-color:rgba(124,92,255,.65);box-shadow:0 0 0 4px rgba(124,92,255,.08)}
.searchbox span{position:absolute;right:15px;top:12px;color:var(--muted)}
.top-actions{margin-left:auto;display:flex;gap:8px}
.iconbtn,.btn{border:1px solid var(--line);background:rgba(255,255,255,.05);color:var(--text);
padding:11px 14px;border-radius:13px;transition:.2s}
.iconbtn:hover,.btn:hover{transform:translateY(-1px);border-color:rgba(124,92,255,.55);background:rgba(124,92,255,.12)}
.btn.primary{border:0;background:linear-gradient(135deg,var(--accent),#5d8cff);box-shadow:0 10px 30px rgba(124,92,255,.2)}
.btn.danger{color:#fecdd3;border-color:rgba(251,113,133,.25)}
.mobile-menu{display:none}
.page{display:none;animation:pageIn .35s ease}.page.active{display:block}
@keyframes pageIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.hero{margin-top:22px;padding:34px;border:1px solid var(--line);border-radius:30px;position:relative;overflow:hidden;
background:linear-gradient(135deg,rgba(124,92,255,.17),rgba(0,212,255,.06) 45%,rgba(255,255,255,.025))}
.hero:before{content:"";position:absolute;width:300px;height:300px;border-radius:50%;right:-90px;top:-130px;
background:radial-gradient(circle,rgba(0,212,255,.22),transparent 65%)}
.hero h2{font-size:clamp(30px,5vw,58px);line-height:1.02;max-width:800px}
.gradient{background:linear-gradient(90deg,#fff,var(--accent2),#a78bfa);-webkit-background-clip:text;color:transparent}
.hero p{max-width:760px;color:var(--muted);font-size:16px;line-height:1.7;margin:16px 0 22px}
.row{display:flex;gap:10px;flex-wrap:wrap}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:18px 0}
.stat,.card{background:#0b1220;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
.stat{padding:20px}.stat b{font-size:27px}.stat span{display:block;color:var(--muted);font-size:13px;margin-top:4px}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:15px;margin:30px 0 14px}
.section-head h3{font-size:22px}.section-head p{color:var(--muted);font-size:13px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.card{padding:19px;transition:.22s}.card:hover{transform:translateY(-3px);border-color:rgba(124,92,255,.35)}
.card .bigico{font-size:30px;margin-bottom:12px}.card h4{font-size:17px;margin-bottom:7px}.card p{font-size:13px;line-height:1.6;color:var(--muted)}
.badge{display:inline-flex;padding:5px 9px;border-radius:999px;background:rgba(124,92,255,.12);
color:#c4b5fd;font-size:11px;margin-bottom:10px}
.tool-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.tool{padding:17px;border:1px solid var(--line);border-radius:18px;background:#080e1a}
.tool button{width:100%;margin-top:12px}
.panel{padding:22px;background:#080d18;border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}
.field{display:grid;gap:7px;margin-bottom:14px}.field label{font-size:12px;color:var(--muted)}
.field input,.field textarea,.field select{width:100%;border:1px solid var(--line);background:#060b15;color:var(--text);
border-radius:13px;padding:12px;outline:none}.field textarea{min-height:110px;resize:vertical}
.ai-layout{display:grid;grid-template-columns:1fr 290px;gap:15px;margin-top:20px}
.chat{height:62vh;min-height:470px;display:flex;flex-direction:column}.messages{flex:1;overflow:auto;padding:6px}
.msg{display:flex;gap:10px;margin:12px 0}.avatar{width:35px;height:35px;border-radius:12px;display:grid;place-items:center;
background:linear-gradient(135deg,var(--accent),var(--accent2));flex:none;font-size:14px}
.bubble{max-width:85%;padding:12px 14px;border-radius:15px;background:rgba(255,255,255,.035);line-height:1.65;font-size:14px}
.msg.user{justify-content:flex-end}.msg.user .avatar{order:2;background:rgba(255,255,255,.055)}
.msg.user .bubble{background:linear-gradient(135deg,rgba(124,92,255,.24),rgba(0,212,255,.08))}
.chat-input{display:flex;gap:8px;border-top:1px solid var(--line);padding-top:12px}.chat-input input{flex:1}
.quick{display:flex;flex-wrap:wrap;gap:7px;margin:9px 0}.quick button{border:1px solid var(--line);background:transparent;color:var(--muted);
border-radius:999px;padding:7px 10px;font-size:11px}
.result{padding:15px;border:1px solid var(--line);border-radius:16px;margin:10px 0;background:rgba(255,255,255,.025)}
.result h4{margin-bottom:6px}.result p{font-size:13px;color:var(--muted);line-height:1.5}


body.game-screen-active{overflow:hidden!important}
body.game-screen-active .game-close{display:block!important}
.game-area button{pointer-events:auto;cursor:pointer}
.game-area.game-open{
  position:fixed!important;
  z-index:5000;
  inset:0;
  width:100vw!important;
  height:100vh!important;
  max-width:none!important;
  margin:0!important;
  border-radius:0!important;
  padding:clamp(18px,4vw,45px)!important;
  display:flex!important;
  align-items:center;
  justify-content:center;
  overflow:auto;
  background:rgba(4,8,18,.96)!important;
  backdrop-filter:blur(18px);
}
.game-area.game-open > div{
  width:min(900px,96vw);
  max-height:90vh;
  overflow:auto;
  padding:clamp(18px,4vw,35px);
  border:1px solid var(--line);
  border-radius:26px;
  background:linear-gradient(145deg,rgba(18,29,52,.98),rgba(10,16,31,.98));
  box-shadow:0 30px 100px rgba(0,0,0,.55);
}
.game-close{
  position:fixed;
  top:18px;
  right:18px;
  z-index:5002;
  width:46px;
  height:46px;
  border:1px solid var(--line);
  border-radius:50%;
  background:var(--panel2);
  color:var(--text);
  font-size:22px;
  cursor:pointer;
}
.game-close:hover{transform:scale(1.05)}

.game-area{min-height:330px;display:grid;place-items:center;text-align:center}.game-board{display:grid;grid-template-columns:repeat(3,70px);gap:8px}
.cell{width:70px;height:70px;border:1px solid var(--line);border-radius:14px;background:#0a1222;color:var(--text);font-size:28px}
canvas{max-width:100%;border-radius:18px;border:1px solid var(--line);background:#07101f}
.todo{display:flex;gap:8px}.todo input{flex:1}.task{display:flex;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid var(--line)}
.task.done span{text-decoration:line-through;color:#64748b}.task span{flex:1}.task button{border:0;background:transparent;color:var(--muted)}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.65);backdrop-filter:blur(10px);z-index:50;display:none;place-items:center;padding:20px}
.modal.show{display:grid}.modalbox{width:min(650px,100%);background:#0d1426;border:1px solid var(--line);border-radius:24px;padding:22px}
.toast{position:fixed;right:22px;bottom:22px;z-index:100;background:#0d1426;border:1px solid var(--line);padding:13px 16px;
border-radius:14px;box-shadow:var(--shadow);display:none}.toast.show{display:block;animation:pageIn .25s}
.overlay{position:fixed;inset:0;pointer-events:none;z-index:0;background-image:linear-gradient(rgba(255,255,255,.015) 1px,transparent 1px),
linear-gradient(90deg,rgba(255,255,255,.015) 1px,transparent 1px);background-size:42px 42px}
footer{text-align:center;color:#64748b;padding:40px 0 10px;font-size:12px}
@media(max-width:1100px){.grid{grid-template-columns:repeat(2,1fr)}.tool-grid{grid-template-columns:repeat(2,1fr)}.stats{grid-template-columns:repeat(2,1fr)}.ai-layout{grid-template-columns:1fr}}
@media(max-width:800px){
.sidebar{transform:translateX(-100%)}.sidebar.open{transform:none}.main{margin-left:0;width:100%;padding:10px 15px 50px}
.mobile-menu{display:block}.topbar{height:58px}.top-actions .hide-mobile{display:none}.hero{padding:24px}.grid{grid-template-columns:1fr}.tool-grid{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}
}
@media(max-width:500px){.stats{grid-template-columns:1fr}.hero h2{font-size:34px}.top-actions{gap:5px}.iconbtn{padding:9px}.chat{min-height:520px}.game-board{grid-template-columns:repeat(3,58px)}.cell{width:58px;height:58px}}

/* NOVA 3.0 UPGRADE */
.kpi-row{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:14px}
.kpi{padding:16px;border:1px solid var(--line);border-radius:18px;background:#080e1a}
.kpi b{font-size:22px;display:block}.kpi span{font-size:11px;color:var(--muted)}
.pillbar{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}.pill{border:1px solid var(--line);background:#080e1a;color:var(--muted);padding:8px 12px;border-radius:999px;font-size:12px;cursor:pointer}.pill.active,.pill:hover{color:var(--text);border-color:rgba(124,92,255,.5);background:rgba(124,92,255,.12)}
.media-card{position:relative;overflow:hidden}.media-top{display:flex;justify-content:space-between;gap:8px;align-items:center}.rating{font-weight:800;color:#fbbf24}
.progress{height:8px;border-radius:99px;background:rgba(255,255,255,.07);overflow:hidden;margin:8px 0}.progress i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .3s}
.cmd-hint{color:var(--muted);font-size:11px;margin-left:auto}.empty{padding:24px;text-align:center;color:var(--muted)}
.leader{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;padding:11px;border-bottom:1px solid var(--line)}
.leader:last-child{border-bottom:0}.rank{font-weight:900;width:28px;text-align:center}.score{font-weight:800}
.flash{animation:flash .35s ease}@keyframes flash{50%{transform:scale(1.05)}}
@media(max-width:1200px){.kpi-row{grid-template-columns:repeat(3,1fr)}}
@media(max-width:700px){.kpi-row{grid-template-columns:1fr 1fr}.cmd-hint{display:none}}


/* NOVA LOGIN */
.auth-overlay{position:fixed;inset:0;z-index:9999;display:none;place-items:center;background:rgba(3,5,12,.82);backdrop-filter:blur(16px);padding:20px}
.auth-overlay.show{display:grid}
.auth-box{width:min(470px,100%);max-height:92vh;overflow:auto;padding:30px;border:1px solid var(--line);border-radius:26px;background:linear-gradient(145deg,rgba(25,25,45,.97),rgba(10,12,25,.97));box-shadow:0 30px 90px rgba(0,0,0,.5)}
.auth-logo{font-size:42px;text-align:center;margin-bottom:8px}.auth-box h2{text-align:center;margin:0}.auth-sub{text-align:center;color:var(--muted);font-size:13px;margin:8px 0 22px}
.auth-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:18px}.auth-tab{padding:10px;border:1px solid var(--line);background:transparent;color:var(--muted);border-radius:12px;cursor:pointer}.auth-tab.active{background:rgba(124,92,255,.15);color:var(--text);border-color:rgba(124,92,255,.5)}
.auth-error{min-height:18px;color:#fb7185;font-size:12px;margin:8px 0}.auth-success{min-height:18px;color:#34d399;font-size:12px;margin:8px 0}
.auth-links{display:flex;justify-content:flex-end;margin-top:8px}.auth-link{border:0;background:none;color:var(--accent2);font-size:12px;cursor:pointer;padding:4px 0}.auth-link:hover{text-decoration:underline}
.remember-row{display:flex;align-items:center;gap:8px;margin:4px 0 8px;color:var(--muted);font-size:12px}.remember-row input{accent-color:var(--accent)}
.recovery-box{margin-top:14px;padding:15px;border:1px solid var(--line);border-radius:16px;background:#080e1a}
.recovery-hint{font-size:12px;color:var(--muted);line-height:1.5;margin:0 0 12px}.recovery-title{font-weight:800;margin-bottom:8px}
.user-chip{display:flex;align-items:center;gap:8px}.avatar{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),var(--accent2));font-size:13px;font-weight:900}
.auth-note{font-size:11px;color:var(--muted);text-align:center;margin-top:16px;line-height:1.5}
/* NOVA_GAME_SCREEN_FINAL */
.game-area.game-open{
  position:fixed !important;
  inset:0 !important;
  z-index:2147483000 !important;
  width:100vw !important;
  height:100vh !important;
  max-width:none !important;
  margin:0 !important;
  border-radius:0 !important;
  overflow:auto !important;
  display:flex !important;
  align-items:center !important;
  justify-content:center !important;
  padding:24px !important;
}
.game-area.game-open > *{position:relative;z-index:2147483001}
.game-close{
  position:fixed !important;
  top:18px !important;
  right:18px !important;
  z-index:2147483647 !important;
  pointer-events:auto !important;
}



.language-select{width:100%;padding:12px 14px;border-radius:12px;border:1px solid var(--border);background:var(--panel);color:var(--text);font-size:15px;outline:none;cursor:pointer}.language-select:focus{border-color:var(--accent)}
.shop-search{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:end}
.shop-search input{width:100%;padding:14px 16px;border:1px solid var(--line);border-radius:14px;background:#060b15;color:var(--text);outline:none}
.shop-search input:focus{border-color:rgba(124,92,255,.55);box-shadow:0 0 0 4px rgba(124,92,255,.08)}
.shop-stores{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}
.shop-store{border:1px solid var(--line);background:#070c17;color:var(--text);padding:10px 13px;border-radius:13px;cursor:pointer;transition:.2s}
.shop-store:hover{transform:translateY(-1px);border-color:rgba(124,92,255,.5);background:#0d1728}
.shop-store.active{background:linear-gradient(135deg,var(--accent),#5d8cff);color:#fff;border-color:transparent}
.shop-hint{color:var(--muted);font-size:12px;margin-top:10px}
@media(max-width:600px){.shop-search{grid-template-columns:1fr}}

</style>
</head>
<body>
<div class="overlay"></div>
<div class="app">
<aside class="sidebar" id="sidebar">
  <div class="brand"><div class="logo">N</div><div><h1>Nova Verse</h1><small>AI • Explore • Create</small></div></div>
  <div class="nav-title">Explore</div>
  <nav class="nav">
    <button class="active" data-page="home">🏠 <span>Home</span></button>
    <button data-page="nova">✦ <span>Nova AI</span></button>
    <button data-page="search">🔎 <span>Web Search</span></button>
    <button data-page="games">🎮 <span>Games</span></button>
    <button data-page="movies">🎬 <span>Movies</span></button>
    <button data-page="songs">🎵 <span>Songs</span></button>
    <button data-page="sports">🏆 <span>Sports</span></button>
    <button data-page="discover">✨ <span>Discover</span></button>
    <button data-page="leaderboard">🏅 <span>Leaderboard</span></button>
    <button data-page="health">❤ <span>Health Tools</span></button>
    <button data-page="education">📚 <span>Education</span></button>
    <button data-page="islam">☪ <span>Quran & Islam</span></button>
    <button data-page="shopping">🛍 <span>Shopping & Food</span></button>
  </nav>
  <div class="nav-title">Personal</div>
  <nav class="nav">
    <button data-page="workspace">📝 <span>Workspace</span></button>
    <button data-page="favorites">★ <span>Favorites</span></button>
    <button data-page="settings">⚙ <span>My Profile</span></button>
    <button data-page="profile">👤 <span>Settings</span></button><button data-page="owner">👑 <span>About Nova</span></button>
  </nav>
  <div class="sidebar-bottom">
    <button class="btn primary" style="width:100%" onclick="openCommand()">⌘ Command Center</button>
  </div>
</aside>

<main class="main">
  <header class="topbar">
    <button class="iconbtn mobile-menu" onclick="toggleSidebar()">☰</button>
    <div class="searchbox"><input id="globalSearch" placeholder="Search Nova Verse or press Ctrl + K…" onkeydown="if(event.key==='Enter')globalSearch()"><span>⌕</span></div>
    <div class="top-actions"><button class="btn" id="authBtn" onclick="openAuth()">🔐 Login</button><span id="authUser"></span>
      <button class="iconbtn hide-mobile" onclick="toggleTheme()" title="Theme">◐</button>
      <button class="iconbtn" onclick="openCommand()" title="Command center">⌘</button>
    </div>
  </header>

  <section class="page active" id="page-home">
    <div class="hero">
      <span class="badge">NOVA VERSE 2.0 • COMPETITION EDITION</span>
      <h2>Your <span class="gradient">intelligent universe</span> in one page.</h2>
      <p>Nova Verse brings AI chat, web search, games, learning, health calculators, entertainment, productivity and discovery together in a fast single-file experience.</p>
      <div class="row">
        <button class="btn primary" onclick="showPage('nova')">✦ Ask Nova</button>
        <button class="btn" onclick="showPage('search')">🔎 Search the web</button>
        <button class="btn" onclick="openCommand()">⌘ Explore everything</button><button class="btn" onclick="showPage('competition')">🏆 Competition Mode</button>
      </div>
    </div>
    <div class="stats">
      <div class="stat"><b id="statChats">0</b><span>Nova conversations</span></div>
      <div class="stat"><b id="statFav">0</b><span>Saved favorites</span></div>
      <div class="stat"><b id="statTasks">0</b><span>Workspace tasks</span></div>
      <div class="stat"><b>∞</b><span>Ideas to explore</span></div>
    </div>
    <div class="section-head"><div><h3>Power modules</h3><p>Everything is connected to the same Nova interface.</p></div></div>
    <div class="grid" id="moduleGrid"></div>

    <div class="section-head"><div><h3>⚡ Nova Pulse</h3><p>Your live local activity dashboard.</p></div><span class="badge">NOVA 3.0</span></div>
    <div class="kpi-row">
      <div class="kpi"><b id="pulseTime">--:--</b><span>Local time</span></div>
      <div class="kpi"><b id="pulseDate">---</b><span>Today</span></div>
      <div class="kpi"><b id="pulseSearches">0</b><span>Searches</span></div>
      <div class="kpi"><b id="pulseFavs">0</b><span>Favorites</span></div>
      <div class="kpi"><b id="pulseStreak">1</b><span>Nova streak</span></div>
    </div>
    <div class="section-head"><div><h3>🧠 Smart Launch</h3><p>Try one of Nova's new shortcuts.</p></div></div>
    <div class="grid">
      <div class="card"><div class="bigico">🌐</div><h4>Research Mode</h4><p>Turn a topic into a focused Google research query.</p><button class="btn primary" onclick="researchMode()">Launch research</button></div>
      <div class="card"><div class="bigico">🎯</div><h4>Daily Challenge</h4><p>Get a random challenge from Nova Arcade.</p><button class="btn primary" onclick="dailyChallenge()">Start challenge</button></div>
      <div class="card"><div class="bigico">✨</div><h4>Surprise Me</h4><p>Nova chooses something interesting to explore.</p><button class="btn primary" onclick="surpriseMe()">Surprise me</button></div>
    </div>

    <div class="section-head"><div><h3>Quick launch</h3><p>Jump straight into a tool.</p></div></div>
    <div class="tool-grid" id="quickGrid"></div>
