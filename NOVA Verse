<div class="auth-overlay" id="authOverlay" onclick="if(event.target===this)closeAuth()">
  <div class="auth-box">
    <div class="auth-logo">🚀</div>
    <h2>Welcome to Nova</h2>
    <div class="auth-sub">Sign in to personalize your Nova Verse experience.</div>

    <div class="auth-tabs">
      <button class="auth-tab active" id="loginTab" onclick="authTab('login')">Login</button>
      <button class="auth-tab" id="signupTab" onclick="authTab('signup')">Create account</button>
    </div>

    <div class="field">
      <label id="authUsernameLabel">Username or Email</label>
      <input id="authEmail" autocomplete="username" placeholder="Enter your username or email">
    </div>

    <div class="field" id="authEmailWrap" style="display:none">
      <label>Email address</label>
      <input id="authSignupEmail" type="email" autocomplete="email" placeholder="Enter your email address">
    </div>

    <div class="field" id="authPassWrap">
      <label>Password</label>
      <input id="authPass" type="password" autocomplete="current-password" placeholder="Enter your password">
    </div>

    <div id="authConfirmWrap" class="field" style="display:none">
      <label>Confirm password</label>
      <input id="authConfirm" type="password" autocomplete="new-password" placeholder="Repeat your password">
    </div>

    <label class="remember-row" id="rememberWrap">
      <input type="checkbox" id="rememberMe">
      <span>Remember me on this device</span>
    </label>

    <div class="auth-links" id="forgotLink">
      <button class="auth-link" type="button" onclick="showForgotPassword()">Forgot password?</button>
    </div>

    <div id="authError" class="auth-error"></div>
    <div id="authSuccess" class="auth-success"></div>

    <button class="btn primary" id="authSubmit" style="width:100%" onclick="submitAuth()">Login to Nova</button>

    <div id="authRecovery" class="recovery-box" style="display:none">
      <div class="recovery-title">🔑 Reset your password</div>
      <input id="recoveryUsername" type="hidden">
      <p class="recovery-hint" id="recoveryHint">Confirm your registered email.</p>

      <div class="field">
        <label>Registered email</label>
        <input id="recoveryEmail" type="email" autocomplete="email" placeholder="Enter your registered email">
      </div>

      <div class="field">
        <label>New password</label>
        <input id="newPassword" type="password" autocomplete="new-password" placeholder="At least 6 characters">
      </div>

      <div class="field">
        <label>Confirm new password</label>
        <input id="newPasswordConfirm" type="password" autocomplete="new-password" placeholder="Repeat your new password">
      </div>

      <button class="btn primary" type="button" style="width:100%" onclick="resetPassword()">Reset password</button>
    </div>

    <button class="btn" id="authBack" type="button" style="width:100%;margin-top:9px;display:none" onclick="backToLogin()">← Back to Login</button>
    <button class="btn" id="guestBtn" type="button" style="width:100%;margin-top:9px" onclick="closeAuth()">Continue as guest</button>

    <div class="auth-note">
      Demo/local login: username, email and password are stored only in this browser using localStorage.
      “Remember me” keeps the login on this device. Password recovery verifies the username and registered email.
      This is not a secure production authentication system and it does not send real emails.
    </div>
  </div>
</div>
</body>
