/* NOVA LOCAL AUTH — username + email + remember me + password recovery */
let authMode='login';

function getUsers(){
  try{return JSON.parse(localStorage.getItem('nova_users')||'{}')}
  catch(e){return {}}
}

function normalizeUsername(v){return String(v||'').trim().toLowerCase()}
function normalizeEmail(v){return String(v||'').trim().toLowerCase()}

function getCurrentUser(){
  return localStorage.getItem('nova_current_user') ||
         sessionStorage.getItem('nova_current_user') || '';
}

function setCurrentUser(username,remember){
  localStorage.removeItem('nova_current_user');
  sessionStorage.removeItem('nova_current_user');
  if(remember) localStorage.setItem('nova_current_user',username);
  else sessionStorage.setItem('nova_current_user',username);
}

function findUser(loginValue){
  const users=getUsers();
  const value=normalizeUsername(loginValue);
  if(!value)return null;

  if(users[value]) return {key:value,user:users[value]};

  for(const key of Object.keys(users)){
    const u=users[key]||{};
    if(normalizeUsername(u.username||key)===value ||
       normalizeEmail(u.email||'')===normalizeEmail(loginValue)){
      return {key,user:u};
    }
  }
  return null;
}

function authTab(mode){
  authMode=mode;
  $('loginTab').classList.toggle('active',mode==='login');
  $('signupTab').classList.toggle('active',mode==='signup');
  $('authConfirmWrap').style.display=mode==='signup'?'block':'none';
  $('authEmailWrap').style.display=mode==='signup'?'block':'none';
  $('authUsernameLabel').textContent=mode==='signup'?'Username':'Username or Email';
  $('authEmail').placeholder=mode==='signup'?'Choose a username':'Enter your username or email';
  $('authSubmit').textContent=mode==='signup'?'Create Nova account':'Login to Nova';
  $('forgotLink').style.display=mode==='login'?'block':'none';
  $('authError').textContent='';
  $('authSuccess').textContent='';
}

function openAuth(){
  $('authOverlay').classList.add('show');
  authTab('login');
  const u=getCurrentUser();
  if(u)$('authEmail').value=u;
  $('rememberMe').checked=localStorage.getItem('nova_remember_me')==='1';
  setTimeout(()=>$('authEmail').focus(),50);
}

function closeAuth(){$('authOverlay').classList.remove('show')}

function submitAuth(){
  if(authMode==='forgot')return startPasswordRecovery();

  const loginValue=$('authEmail').value.trim();
  const pass=$('authPass').value;
  const confirm=$('authConfirm').value;
  const email=normalizeEmail($('authSignupEmail').value);
  const remember=$('rememberMe').checked;

  $('authError').className='auth-error';
  $('authError').textContent='';
  $('authSuccess').textContent='';

  if(!loginValue||!pass){
    $('authError').textContent='Please enter your username/email and password.';
    return;
  }

  const users=getUsers();

  if(authMode==='signup'){
    const username=normalizeUsername(loginValue);

    if(!/^[a-z0-9_.-]{3,24}$/i.test(username)){
      $('authError').textContent='Username must be 3–24 characters and use letters, numbers, _, . or -.';
      return;
    }
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){
      $('authError').textContent='Please enter a valid email address.';
      return;
    }
    if(pass.length<6){
      $('authError').textContent='Password must be at least 6 characters.';
      return;
    }
    if(pass!==confirm){
      $('authError').textContent='Passwords do not match.';
      return;
    }
    if(users[username]){
      $('authError').textContent='That username already exists. Try another one.';
      return;
    }

    for(const key of Object.keys(users)){
      if(normalizeEmail(users[key]?.email||'')===email){
        $('authError').textContent='That email is already registered.';
        return;
      }
    }

    users[username]={
      username,
      email,
      password:pass,
      created:new Date().toISOString()
    };
    localStorage.setItem('nova_users',JSON.stringify(users));
    localStorage.setItem('nova_remember_me',remember?'1':'0');
    setCurrentUser(username,remember);
    closeAuth();
    updateAuthUI();
    toast('Account created — welcome to Nova! 🚀');
    return;
  }

  const found=findUser(loginValue);
  if(!found){
    $('authError').textContent='Account not found. Check your username/email or create an account.';
    return;
  }
  if(found.user.password!==pass){
    $('authError').textContent='Incorrect password.';
    return;
  }

  const username=found.user.username||found.key;
  localStorage.setItem('nova_remember_me',remember?'1':'0');
  setCurrentUser(username,remember);
  closeAuth();
  updateAuthUI();
  toast('Welcome back to Nova! 👋');
}

