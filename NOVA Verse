function localAnswer(q){
  const l=q.toLowerCase();
  if(/what can nova|features|nova verse/.test(l))return "Nova Verse 3.0 is a <b>single-file digital universe</b> with AI chat modes, Google search, games, movies, music, sports, health tools, education, discovery, favorites, tasks, notes and achievements.";
  if(/hello|hi |hey/.test(l))return "Hello! 👋 I'm Nova. Pick a mode and give me a challenge.";
  if(/who (made|created)|owner|abdullah/.test(l))return "Nova Verse lists <b>Abdullah Ateeq</b> as its creator.";
  if(/open (games?|arcade)/.test(l)){showPage('games');return "Opening <b>Nova Arcade</b> 🎮."}
  if(/open (workspace|tasks|notes)/.test(l)){showPage('workspace');return "Opening your <b>Workspace</b> 📝."}
  if(/open (search|google)/.test(l)){showPage('search');return "Opening <b>Web Search</b> 🔎."}
  if(/open (movies?|cinema)/.test(l)){showPage('movies');return "Opening <b>Nova Cinema</b> 🎬."}
  if(/open (songs?|music)/.test(l)){showPage('songs');return "Opening <b>Nova Music Hub</b> 🎵."}
  if(/open (sports?)/.test(l)){showPage('sports');return "Opening <b>Sports Center</b> 🏆."}
  if(/open (health)/.test(l)){showPage('health');return "Opening <b>Health Lab</b> ❤️."}
  if(/open (discover)/.test(l)){showPage('discover');return "Opening <b>Nova Discover</b> ✨."}
  if(/dark mode/.test(l)){if(state.theme!=='dark')toggleTheme();return "Dark mode is on. 🌙"}
  if(/light mode/.test(l)){if(state.theme!=='light')toggleTheme();return "Light mode is on. ☀️"}
  if(/^(calculate|what is|solve)\b/.test(l)||/^\d+[\d\s+\-*/().%]+$/.test(l)){
    const expr=q.replace(/^(calculate|what is|solve)\s*/i,'').replace(/[^0-9+\-*/().% ]/g,'');
    try{if(expr&&/[0-9]/.test(expr)){const result=Function('"use strict";return ('+expr+')')();if(Number.isFinite(result))return `The answer is <b>${result}</b>.`;}}catch(e){}
  }
  if(/artificial intelligence|machine learning|\bai\b/.test(l)){
    let base="Artificial intelligence is the field of building systems that perform tasks associated with human intelligence, such as recognizing patterns, generating language, making predictions and solving problems.";
    if(aiMode==='teacher')base+="<br><br><b>Teacher mode:</b> Think of AI as software that learns patterns from examples and then uses those patterns to produce useful results.";
    if(aiMode==='coder')base+="<br><br><b>Coder mode:</b> A practical AI app usually has a user interface, an inference/model layer, data handling and sometimes APIs or a backend.";
    if(aiMode==='creative')base+="<br><br><b>Creative mode:</b> Imagine Nova as a digital control room where search, learning, games and creation meet.";
    return base;
  }
  if(/coding|programming|project ideas/.test(l))return "Strong competition ideas: <b>1.</b> AI study coach, <b>2.</b> accessibility assistant, <b>3.</b> research dashboard, <b>4.</b> productivity workspace, <b>5.</b> interactive learning universe. Nova Verse combines several of these directions.";
  if(/time|date/.test(l))return "Your browser's current date/time is <b>"+new Date().toLocaleString()+"</b>.";
  if(/weather|news|latest|score|price|stock/.test(l))return "That needs live information. I'll send you to <b>Google Web Search</b> so you can get current results.";
  if(/thank/.test(l))return "You're welcome! 🚀 Keep building.";
  return "I can help with explanations, calculations, Nova commands and project ideas. For live information, use <b>Web Search</b>. Try <i>open games</i>, <i>calculate 25 * 48</i>, or <i>open discover</i>.";
}

