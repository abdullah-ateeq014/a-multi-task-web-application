  authTab('login');
}

function startPasswordRecovery(){
  const username=normalizeUsername($('authEmail').value);
  const found=findUser(username);

  $('authError').textContent='';
  $('authSuccess').textContent='';

  if(!found || normalizeUsername(found.user.username||found.key)!==username){
    $('authError').textContent='Username not found. Enter the username you used when creating the account.';
    return;
  }

  const registeredEmail=normalizeEmail(found.user.email||'');
  if(!registeredEmail){
    $('authError').textContent='This account does not have a recovery email. Please create a new account.';
    return;
  }

  $('recoveryUsername').value=found.user.username||found.key;
  $('recoveryHint').textContent='Recovery email on this account: '+maskEmail(registeredEmail);
  $('recoveryEmail').value='';
  $('newPassword').value='';
  $('newPasswordConfirm').value='';
  $('authRecovery').style.display='block';
  $('authSubmit').style.display='none';
  $('authError').textContent='';
  $('authSuccess').textContent='Username verified ✓ Now confirm your registered email.';
}

function maskEmail(email){
  const [name,domain]=email.split('@');
  if(!domain)return email;
  const shown=name.length<=2?name.charAt(0)+'*':name.charAt(0)+'***'+name.charAt(name.length-1);
  return shown+'@'+domain;
}

function resetPassword(){
  const username=normalizeUsername($('recoveryUsername').value);
  const email=normalizeEmail($('recoveryEmail').value);
  const pass=$('newPassword').value;
  const confirm=$('newPasswordConfirm').value;
  const users=getUsers();
  const found=findUser(username);

  $('authError').textContent='';
  $('authSuccess').textContent='';

  if(!found || normalizeUsername(found.user.username||found.key)!==username){
    $('authError').textContent='Username verification expired. Start again.';
    return;
  }
  if(normalizeEmail(found.user.email||'')!==email){
    $('authError').textContent='The email does not match the email registered with this username.';
    return;
  }
  if(pass.length<6){
    $('authError').textContent='New password must be at least 6 characters.';
    return;
  }
  if(pass!==confirm){
    $('authError').textContent='New passwords do not match.';
    return;
  }

  users[found.key].password=pass;
  users[found.key].updated=new Date().toISOString();
  localStorage.setItem('nova_users',JSON.stringify(users));

  $('authRecovery').style.display='none';
  $('authSubmit').style.display='block';
  $('authBack').style.display='none';
  $('authPassWrap').style.display='block';
  $('rememberWrap').style.display='flex';
  authTab('login');
  $('authEmail').value=username;
  $('authPass').value='';
  $('authSuccess').textContent='Password changed successfully ✓ You can now log in.';
}

function logoutNova(){
  localStorage.removeItem('nova_current_user');
  sessionStorage.removeItem('nova_current_user');
  localStorage.removeItem('nova_remember_me');
  updateAuthUI();
  toast('Logged out. You can continue as a guest.');
}

function updateAuthUI(){
  const u=getCurrentUser();
  const btn=$('authBtn'),box=$('authUser');
  if(!btn)return;
  if(u){
    btn.textContent='🚪 Logout';
    btn.onclick=logoutNova;
    if(box)box.innerHTML=`<span class="user-chip"><span class="avatar">${escapeHtml(u.charAt(0).toUpperCase())}</span><span>${escapeHtml(u)}</span></span>`;
  }else{
    btn.textContent='🔐 Login';
    btn.onclick=openAuth;
    if(box)box.innerHTML='';
  }
}

function restoreRememberedLogin(){
  const remembered=localStorage.getItem('nova_current_user');
  const remember=localStorage.getItem('nova_remember_me')==='1';
  if(remember && remembered){
    sessionStorage.removeItem('nova_current_user');
  }else if(remembered && !remember){
    localStorage.removeItem('nova_current_user');
  }
  updateAuthUI();
}


